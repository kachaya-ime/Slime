<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/conversion_header">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="use_google_api"
            app:title="@string/google_api_title"
            />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/dictionary_header">

        <Preference
            app:key="learn_dict_setting"
            app:title="@string/learn_dict_title"
            app:summary="@string/learn_dict_summary" />

    </PreferenceCategory>

</PreferenceScreen>
