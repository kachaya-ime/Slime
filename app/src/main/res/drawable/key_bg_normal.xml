<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow offset to the right and bottom -->
    <item android:left="4dp" android:top="4dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Main key body -->
    <item android:left="2dp" android:top="2dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#CBCBCB" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
